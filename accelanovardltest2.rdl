  </am:AuthoringMetadata>

  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>DataSource1</DataSourceReference>
      <rd:DataSourceID>8d7d9a6b-6f3c-4c62-8a6c-1b2f3b4c5d6e</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <ReportParameters>
    <ReportParameter Name="RecordID">
      <DataType>String</DataType>
      <Prompt>Record ID</Prompt>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
    </ReportParameter>
  </ReportParameters>

  <DataSets>
    <DataSet Name="dsMain">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RecordID">
            <Value>=Parameters!RecordID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[
DECLARE @RecordID varchar(20) = @RecordID;

;WITH base AS (
    SELECT
        b.SERV_PROV_CODE,
        b.B1_PER_ID1, b.B1_PER_ID2, b.B1_PER_ID3,
        b.REC_STATUS,
        b.B1_ALT_ID,
        b.B1_CREATED_BY
    FROM B1PERMIT b
    WHERE
        b.SERV_PROV_CODE = 'AGR'
        AND b.REC_STATUS = 'A'
        AND b.B1_ALT_ID = @RecordID
),
complainant AS (
    SELECT
        c.SERV_PROV_CODE, c.B1_PER_ID1, c.B1_PER_ID2, c.B1_PER_ID3, c.REC_STATUS,
        COALESCE(c.B1_FULL_NAME, LTRIM(RTRIM(CONCAT(c.B1_FNAME,' ',c.B1_LNAME)))) AS ComplainantName,
        c.B1_PHONE1 AS ComplainantPhone,
        c.B1_ADDRESS1 AS ComplainantAddressLine1,
        LTRIM(RTRIM(CONCAT(c.B1_CITY, ', ', c.B1_STATE, ' ', c.B1_ZIP))) AS ComplainantCityStateZip
    FROM B3CONTACT c
    JOIN base b ON
        b.SERV_PROV_CODE = c.SERV_PROV_CODE
        AND b.B1_PER_ID1 = c.B1_PER_ID1
        AND b.B1_PER_ID2 = c.B1_PER_ID2
        AND b.B1_PER_ID3 = c.B1_PER_ID3
        AND b.REC_STATUS  = c.REC_STATUS
    WHERE
        c.REC_STATUS = 'A'
        AND c.B1_CONTACT_TYPE = 'Complainant'
        AND c.B1_CONTACT_NBR = (
            SELECT MIN(c2.B1_CONTACT_NBR)
            FROM B3CONTACT c2
            WHERE
                c2.SERV_PROV_CODE = c.SERV_PROV_CODE
                AND c2.B1_PER_ID1 = c.B1_PER_ID1
                AND c2.B1_PER_ID2 = c.B1_PER_ID2
                AND c2.B1_PER_ID3 = c.B1_PER_ID3
                AND c2.REC_STATUS = c.REC_STATUS
                AND c2.B1_CONTACT_TYPE = c.B1_CONTACT_TYPE
                AND COALESCE(c2.B1_FLAG,'N') = (
                    SELECT MAX(COALESCE(c3.B1_FLAG,'N'))
                    FROM B3CONTACT c3
                    WHERE
                        c3.SERV_PROV_CODE = c2.SERV_PROV_CODE
                        AND c3.B1_PER_ID1 = c2.B1_PER_ID1
                        AND c3.B1_PER_ID2 = c2.B1_PER_ID2
                        AND c3.B1_PER_ID3 = c2.B1_PER_ID3
                        AND c3.REC_STATUS = c2.REC_STATUS
                        AND c3.B1_CONTACT_TYPE = c2.B1_CONTACT_TYPE
                )
        )
),
comments AS (
    SELECT
        b.SERV_PROV_CODE, b.B1_PER_ID1, b.B1_PER_ID2, b.B1_PER_ID3, b.REC_STATUS,
        STRING_AGG(CONVERT(varchar(max), pc.[TEXT]),
                   CHAR(13) + CHAR(10) + '---' + CHAR(13) + CHAR(10))
            WITHIN GROUP (ORDER BY pc.REC_DATE) AS Notes
    FROM base b
    LEFT JOIN BPERMIT_COMMENT pc ON
        b.SERV_PROV_CODE = pc.SERV_PROV_CODE
        AND b.B1_PER_ID1 = pc.B1_PER_ID1
        AND b.B1_PER_ID2 = pc.B1_PER_ID2
        AND b.B1_PER_ID3 = pc.B1_PER_ID3
    WHERE
        (pc.REC_STATUS = 'A' OR pc.REC_STATUS IS NULL)
    GROUP BY
        b.SERV_PROV_CODE, b.B1_PER_ID1, b.B1_PER_ID2, b.B1_PER_ID3, b.REC_STATUS
),
asi AS (
    SELECT
        pvt.SERV_PROV_CODE, pvt.B1_PER_ID1, pvt.B1_PER_ID2, pvt.B1_PER_ID3,
        pvt.[Incident Location],
        pvt.[Incident Date],
        pvt.[Incident Time],
        pvt.[Type of Complaint],
        pvt.[Crop/Site],
        pvt.[Pesticide],
        pvt.[Landowner Name],
        pvt.[Landowner Address],
        pvt.[Landowner Phone],
        pvt.[Incident Summary],
        pvt.[Principal Owner of Pesticide Business],
        pvt.[Business Name],
        pvt.[Business Address],
        pvt.[Application Made By]
    FROM (
        SELECT
            bc.SERV_PROV_CODE,
            bc.B1_PER_ID1, bc.B1_PER_ID2, bc.B1_PER_ID3,
            bc.B1_CHECKBOX_DESC,
            bc.B1_CHECKLIST_COMMENT
        FROM BCHCKBOX bc
        JOIN base b ON
            b.SERV_PROV_CODE = bc.SERV_PROV_CODE
            AND b.B1_PER_ID1 = bc.B1_PER_ID1
            AND b.B1_PER_ID2 = bc.B1_PER_ID2
            AND b.B1_PER_ID3 = bc.B1_PER_ID3
        WHERE
            bc.REC_STATUS = 'A'
            AND bc.B1_CHECKBOX_DESC IN (
                'Incident Location','Incident Date','Incident Time','Type of Complaint','Crop/Site','Pesticide',
                'Landowner Name','Landowner Address','Landowner Phone','Incident Summary',
                'Principal Owner of Pesticide Business','Business Name','Business Address','Application Made By'
            )
    ) a
    PIVOT (
        MAX(a.B1_CHECKLIST_COMMENT)
        FOR a.B1_CHECKBOX_DESC IN (
            [Incident Location],[Incident Date],[Incident Time],[Type of Complaint],[Crop/Site],[Pesticide],
            [Landowner Name],[Landowner Address],[Landowner Phone],[Incident Summary],
            [Principal Owner of Pesticide Business],[Business Name],[Business Address],[Application Made By]
        )
    ) pvt
)
SELECT
    b.B1_ALT_ID                         AS RecordID,
    CAST(GETDATE() AS date)             AS ReportRunDate,
    CONVERT(varchar(8), GETDATE(), 108) AS ReportRunTime,
    b.B1_CREATED_BY                     AS ContactReceivedBy,

    c.ComplainantName,
    c.ComplainantPhone,
    c.ComplainantAddressLine1,
    c.ComplainantCityStateZip,

    asi.[Incident Location]             AS IncidentLocation,
    asi.[Incident Date]                 AS IncidentDate,
    asi.[Incident Time]                 AS IncidentTime,
    asi.[Type of Complaint]             AS TypeOfComplaintDamage,
    asi.[Crop/Site]                     AS CropSite,
    asi.[Pesticide]                     AS Pesticides,
    asi.[Landowner Name]                AS LandownerName,
    asi.[Landowner Address]             AS LandownerAddress,
    asi.[Landowner Phone]               AS LandownerPhone,
    asi.[Incident Summary]              AS IncidentSummary,
    asi.[Principal Owner of Pesticide Business] AS PrincipalOwnerPesticideBusiness,
    asi.[Business Name]                 AS BusinessName,
    asi.[Business Address]              AS BusinessAddress,
    asi.[Application Made By]           AS ApplicationMadeBy,

    cm.Notes                            AS Notes
FROM base b
LEFT JOIN complainant c ON
    b.SERV_PROV_CODE = c.SERV_PROV_CODE
    AND b.B1_PER_ID1 = c.B1_PER_ID1
    AND b.B1_PER_ID2 = c.B1_PER_ID2
    AND b.B1_PER_ID3 = c.B1_PER_ID3
    AND b.REC_STATUS  = c.REC_STATUS
LEFT JOIN asi ON
    b.SERV_PROV_CODE = asi.SERV_PROV_CODE
    AND b.B1_PER_ID1 = asi.B1_PER_ID1
    AND b.B1_PER_ID2 = asi.B1_PER_ID2
    AND b.B1_PER_ID3 = asi.B1_PER_ID3
LEFT JOIN comments cm ON
    b.SERV_PROV_CODE = cm.SERV_PROV_CODE
    AND b.B1_PER_ID1 = cm.B1_PER_ID1
    AND b.B1_PER_ID2 = cm.B1_PER_ID2
    AND b.B1_PER_ID3 = cm.B1_PER_ID3
    AND b.REC_STATUS  = cm.REC_STATUS;
]]></CommandText>
      </Query>
      <Fields>
        <Field Name="RecordID"><DataField>RecordID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReportRunDate"><DataField>ReportRunDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="ReportRunTime"><DataField>ReportRunTime</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ContactReceivedBy"><DataField>ContactReceivedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field>

        <Field Name="ComplainantName"><DataField>ComplainantName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ComplainantPhone"><DataField>ComplainantPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ComplainantAddressLine1"><DataField>ComplainantAddressLine1</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ComplainantCityStateZip"><DataField>ComplainantCityStateZip</DataField><rd:TypeName>System.String</rd:TypeName></Field>

        <Field Name="IncidentLocation"><DataField>IncidentLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="IncidentDate"><DataField>IncidentDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="IncidentTime"><DataField>IncidentTime</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TypeOfComplaintDamage"><DataField>TypeOfComplaintDamage</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CropSite"><DataField>CropSite</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Pesticides"><DataField>Pesticides</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LandownerName"><DataField>LandownerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LandownerAddress"><DataField>LandownerAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LandownerPhone"><DataField>LandownerPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="IncidentSummary"><DataField>IncidentSummary</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PrincipalOwnerPesticideBusiness"><DataField>PrincipalOwnerPesticideBusiness</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="BusinessName"><DataField>BusinessName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="BusinessAddress"><DataField>BusinessAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ApplicationMadeBy"><DataField>ApplicationMadeBy</DataField><rd:TypeName>System.String</rd:TypeName></Field>

        <Field Name="Notes"><DataField>Notes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>dsMain</rd:DataSetName>
        <rd:TableName>dsMain</rd:TableName>
      </rd:DataSetInfo>
    </DataSet>

    <DataSet Name="dsOtherPersons">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RecordID">
            <Value>=Parameters!RecordID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[
DECLARE @RecordID varchar(20) = @RecordID;

SELECT
    b.B1_ALT_ID AS RecordID,
    c.B1_CONTACT_TYPE AS ContactType,
    COALESCE(c.B1_FULL_NAME, LTRIM(RTRIM(CONCAT(c.B1_FNAME,' ',c.B1_LNAME)))) AS FullName,
    c.B1_ADDRESS1 AS AddressLine1,
    LTRIM(RTRIM(CONCAT(c.B1_CITY, ', ', c.B1_STATE, ' ', c.B1_ZIP))) AS CityStateZip,
    c.B1_PHONE2 AS MobilePhone,
    c.B1_PHONE1 AS Phone1,
    c.B1_EMAIL  AS Email
FROM B1PERMIT b
JOIN B3CONTACT c ON
    b.SERV_PROV_CODE = c.SERV_PROV_CODE
    AND b.B1_PER_ID1 = c.B1_PER_ID1
    AND b.B1_PER_ID2 = c.B1_PER_ID2
    AND b.B1_PER_ID3 = c.B1_PER_ID3
    AND b.REC_STATUS  = c.REC_STATUS
WHERE
    b.SERV_PROV_CODE = 'AGR'
    AND b.REC_STATUS = 'A'
    AND c.REC_STATUS = 'A'
    AND b.B1_ALT_ID = @RecordID
    AND c.B1_CONTACT_TYPE <> 'Complainant'
ORDER BY
    c.B1_CONTACT_TYPE, c.B1_CONTACT_NBR;
]]></CommandText>
      </Query>
      <Fields>
        <Field Name="RecordID"><DataField>RecordID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ContactType"><DataField>ContactType</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="FullName"><DataField>FullName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AddressLine1"><DataField>AddressLine1</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CityStateZip"><DataField>CityStateZip</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MobilePhone"><DataField>MobilePhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Phone1"><DataField>Phone1</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Email"><DataField>Email</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>dsOtherPersons</rd:DataSetName>
        <rd:TableName>dsOtherPersons</rd:TableName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>

  <ReportSections>
    <ReportSection>
