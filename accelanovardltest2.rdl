              <Textbox Name="LblTypeComplaint">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>Type of Complaint/Damage</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>58mm</Top><Left>0mm</Left><Height>6mm</Height><Width>45mm</Width>
              </Textbox>
              <Textbox Name="ValTypeComplaint">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!TypeOfComplaintDamage.Value, "dsMain")</Value></TextRun></TextRuns></Paragraph></Paragraphs>
