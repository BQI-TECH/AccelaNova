              <Textbox Name="ValIncidentDate">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!IncidentDate.Value, "dsMain")</Value></TextRun></TextRuns></Paragraph></Paragraphs>
