                <TextRuns>
                  <TextRun>
                    <Value>MONTANA DEPARTMENT</Value>
                    <Style>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>13mm</Top>
            <Left>0mm</Left>
            <Height>7mm</Height>
            <Width>170mm</Width>
            <Style>
              <Border><Style>None</Style></Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>

          <!-- Main form layout -->
          <Rectangle Name="MainForm">
            <Top>22mm</Top>
            <Left>0mm</Left>
            <Height>190mm</Height>
            <Width>170mm</Width>
            <Style>
              <Border><Style>None</Style></Border>
            </Style>
            <ReportItems>

              <!-- Row helper: label/value pairs -->
              <!-- Date / Time -->
              <Textbox Name="LblDate">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>Today’s Date</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>0mm</Top><Left>0mm</Left><Height>6mm</Height><Width>45mm</Width>
                <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
              </Textbox>
              <Textbox Name="ValDate">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!ReportRunDate.Value, "dsMain")</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>0mm</Top><Left>50mm</Left><Height>6mm</Height><Width>55mm</Width>
                <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
              </Textbox>

              <Textbox Name="LblTime">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>Time</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>0mm</Top><Left>110mm</Left><Height>6mm</Height><Width>20mm</Width>
                <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
              </Textbox>
              <Textbox Name="ValTime">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!ReportRunTime.Value, "dsMain")</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>0mm</Top><Left>132mm</Left><Height>6mm</Height><Width>38mm</Width>
                <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
              </Textbox>

              <!-- Complainant -->
              <Textbox Name="LblComplainantName">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>Complainant’s Name</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>8mm</Top><Left>0mm</Left><Height>6mm</Height><Width>45mm</Width>
              </Textbox>
