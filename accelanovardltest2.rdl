              <Textbox Name="LblCropSite">
                <Paragraphs><Paragraph><TextRuns><TextRun><Value>Crop/Site</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                <Top>65mm</Top><Left>0mm</Left><Height>6mm</Height><Width>45mm</Width>
